# ── RasOI Backend Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.

# Claude API key (required — Vision + substitutions)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Continental recipe API (optional — used for Italian/Mexican recipes)
SPOONACULAR_API_KEY=

# Database
DATABASE_URL=sqlite:///./rasoi.db

# Supabase (image storage + Indian recipe catalogue)
# Get these from your Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
RASOI_DEMO_USER_ID=5d6b4c66-945a-414e-92e4-8fe99ca89e6a

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
