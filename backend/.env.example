# ── Food Buddy Backend Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.

# Anthropic Claude (required — Vision + recipes + substitutions + Chammach agent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-8

# Continental recipe API (optional — used for cuisines not in the local catalogue)
SPOONACULAR_API_KEY=

# Database
DATABASE_URL=sqlite:///./rasoi.db

# Supabase (image storage + recipe catalogue + Collect&Go customer data)
# Get these from your Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
RASOI_DEMO_USER_ID=5d6b4c66-945a-414e-92e4-8fe99ca89e6a

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
