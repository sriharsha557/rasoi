# Root gitignore for RasOI monorepo
# Cghackthon@2026
# Environment variables
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.iml
*.sublime-*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.cache/
temp/
tmp/

# Local databases and test caches
*.db
*.sqlite
*.sqlite3
.hypothesis/
.pytest_cache/

# Old backup snapshots (not part of the live source tree)
backend/files/
backend/files.zip
